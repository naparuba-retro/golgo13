  },
  "00b2b000/05": {
   "ja": "森林調査団に紛れて亡命を計画している…",
   "text": "Il prépare sa fuite à l'étranger en se mêlant à une mission d'étude forestière…",
   "style": "caption"
  },
  "00b2b000/06": {
   "ja": "このまま放ってはおけないのだが…",
   "text": "On ne peut pas le laisser faire…",
   "style": "caption"
  },
  "00b2b000/07": {
   "ja": "その顔も、今は整形でわかりはしねえ…",
   "text": "Même son visage est méconnaissable, avec la chirurgie esthétique…",
   "style": "caption"
  },
  "00b2b000/08": {
   "ja": "この仕事にはあんたの鋭い嗅覚が必要なんだ！",
   "text": "Pour ce travail, il me faut votre flair !",
   "style": "caption"
  },
  "00b2b000/09": {
   "ja": "頼む、Mr.トウゴウ！",
   "text": "Je compte sur vous, M. Togo !",
   "style": "caption"
  },
  "00b2b000/10": {
   "ja": "企業集団のボス　ルカシェンコ",
   "text": "Patron du groupe Loukachenko",
   "style": "plate"
  },
  "00b2b000/11": {
   "ja": "スルタノフ",
   "text": "Sultanov",
   "style": "plate"
  },
  "00d4b000/00": {
   "ja": "情報局長は君達の活躍に大変満足している…",
   "text": "Le directeur du service est très satisfait de votre action…",
   "style": "caption"
  },
  "00d4b000/01": {
   "ja": "しかし、ここにきてこの国の警察も…",
   "text": "Mais voilà que la police de ce pays aussi…",
   "style": "caption"
  },
  "00d4b000/02": {
   "ja": "君達の行動に不信感を抱いているようだ…",
   "text": "semble se méfier de vos agissements…",
   "style": "caption"
  },
  "00d4b000/03": {
   "ja": "そこで君達には一時的に帰国してもらう。",
   "text": "Vous allez donc rentrer au pays pour un temps.",
   "style": "caption"
  },
  "00d4b000/04": {
   "ja": "命は守ってもらえるのでしょうね…？",
   "text": "Ma vie sera protégée, n'est-ce pas… ?",
   "style": "caption"
  },
  "00d4b000/05": {
   "ja": "もちろんだ！",
   "text": "Bien sûr !",
   "style": "caption"
  },
  "00d4b000/06": {
   "ja": "そのために世界一の男を呼んである…",
   "text": "Pour cela, j'ai fait appel au meilleur homme du monde…",
   "style": "caption"
  },
  "00d4b000/07": {
   "ja": "止まれ！",
   "text": "Halte !",
   "style": "caption"
  },
  "00d4b000/08": {
   "ja": "動くな！",
   "text": "Ne bougez pas !",
   "style": "caption"
  },
  "00d4b000/09": {
   "ja": "…せ、戦車だ！",
   "text": "…U-un char d'assaut !",
   "style": "caption"
  },
  "00d4b000/10": {
   "ja": "情報局局員　ソメール",
   "text": "Agent du service Sommer",
   "style": "plate"
  },
  "00d4b000/11": {
   "ja": "情報局スパイ　ブラッコ夫妻",
   "text": "Espions du service Bracco",
   "style": "plate"
  },
  "00f34000/00": {
   "ja": "自動車というものは我が国で発明され…",
   "text": "L'automobile a été inventée dans notre pays…",
   "style": "caption"
  },
  "00f34000/01": {
   "ja": "…そして発展した。",
   "text": "…et s'y est développée.",
   "style": "caption"
  },
  "00f34000/02": {
   "ja": "我々は車に関して…負けてはならないのです！",
   "text": "En matière d'automobile… nous ne devons pas perdre !",
   "style": "caption"
  },
  "00f34000/03": {
   "ja": "ターゲットのマシンです。",
   "text": "Voici la machine de la cible.",
   "style": "caption"
  },
  "00f34000/04": {
   "ja": "来月のラリーでリタイアさせて欲しいのです…",
   "text": "Je veux qu'elle abandonne au rallye du mois prochain…",
   "style": "caption"
  },
  "00f34000/05": {
   "ja": "ただし、痕跡が残るのは困ります…",
   "text": "Mais il ne faut surtout pas laisser de traces…",
   "style": "caption"
  },
  "00f34000/06": {
   "ja": "…タイヤのトラブルに見せかけて欲しいのです。",
   "text": "…faites croire à un problème de pneu.",
   "style": "caption"
  },
  "00f34000/07": {
   "ja": "舞い上がる砂塵の中での正確な狙撃は…",
   "text": "Un tir précis dans un nuage de poussière…",
   "style": "caption"
  },
  "00f34000/08": {
   "ja": "あなたにしかできないのです！",
   "text": "Vous seul en êtes capable !",
   "style": "caption"
  },
  "00f34000/09": {
   "ja": "自動車連盟幹部　アリソン",
   "text": "Féd. automobile Allison",
   "style": "plate"
  },
  "01127000/00": {
   "ja": "こうやって杯を交わすのも…",
   "text": "Trinquer ainsi, ensemble…",
   "style": "caption"
  },
  "01127000/01": {
   "ja": "…本当に久しぶりだな。",
   "text": "…ça fait vraiment longtemps.",
   "style": "caption"
  },
  "01127000/02": {
   "ja": "ところで、相談があるとの事だったが…？",
   "text": "Au fait, tu voulais me consulter… ?",
   "style": "caption"
  },
  "01127000/03": {
   "ja": "マリオーリを知っているか？",
   "text": "Connais-tu Marioli ?",
   "style": "caption"
  },
  "01127000/04": {
   "ja": "新鋭の水上スキーヤーだな…",
   "text": "Ce jeune espoir du ski nautique…",
   "style": "caption"
  },
  "01127000/05": {
   "ja": "やつめ、このわしの弱みにつけこんで…",
   "text": "Ce type, profitant de ma faiblesse…",
   "style": "caption"
  },
  "01127000/06": {
   "ja": "金銭を要求してきた…",
   "text": "m'a réclamé de l'argent…",
   "style": "caption"
  },
  "01127000/07": {
   "ja": "弱みに心当たりはあるんだな？",
   "text": "Tu vois donc de quelle faiblesse il s'agit ?",
   "style": "caption"
  },
  "01127000/08": {
   "ja": "しかし、やつなんかに金を取られるのは…",
   "text": "Mais me laisser extorquer par un type pareil…",
   "style": "caption"
  },
  "01127000/09": {
   "ja": "プライドが許さん！",
   "text": "Mon orgueil ne le permet pas !",
   "style": "caption"
  },
  "01127000/10": {
   "ja": "だから元公安の私に相談というわけか…",
   "text": "Alors tu viens trouver l'ancien de la Sûreté que je suis…",
   "style": "caption"
  },
  "01127000/11": {
   "ja": "……",
   "text": "……",
   "style": "caption"
  },
  "01127000/12": {
   "ja": "始末するか…？",
   "text": "On s'en débarrasse… ?",
   "style": "caption"
  },
  "01127000/13": {
   "ja": "そんな事は…",
   "text": "Je n'irais pas jusque-là…",
   "style": "caption"
  },
  "01127000/14": {
   "ja": "まあ、私に任せるんだな…",
   "text": "Bon, laisse-moi faire…",
   "style": "caption"
  },
  "01127000/15": {
   "ja": "…ターゲットのマリオーリだ！",
   "text": "…La cible, c'est Marioli !",
   "style": "caption"
  },
  "01127000/16": {
   "ja": "水上スキーの事故を演出して欲しい…",
   "text": "Je veux que tu mettes en scène un accident de ski nautique…",
   "style": "caption"
  },
  "01127000/17": {
   "ja": "元公安委員長　シェル",
   "text": "Ex-chef de la Sûreté Shell",
   "style": "plate"
  },
  "01127000/18": {
   "ja": "実業家　ホーソン",
   "text": "Homme d'affaires Hawthorne",
   "style": "plate"
  },
  "012e3000/00": {
   "ja": "…差出人、情報局ウイリアムズ…",
   "text": "…Expéditeur : service de renseignement, Williams…",
   "style": "caption"
  },
  "012e3000/01": {
   "ja": "久々だな…デューク…",
   "text": "Ça fait longtemps… Duke…",
   "style": "caption"
  },
  "012e3000/02": {
   "ja": "早速だが…悪いニュースだ。",
   "text": "Allons droit au but… j'ai de mauvaises nouvelles.",
   "style": "caption"
  },
  "012e3000/03": {
   "ja": "実は情報局の一部の人間が暴走して…",
   "text": "En fait, certains éléments du service ont dérapé…",
   "style": "caption"
  },
  "012e3000/04": {
   "ja": "…生物学を駆使した戦士を開発したのだ。",
   "text": "…ils ont mis au point un guerrier issu de la biologie.",
   "style": "caption"
  },
  "012e3000/05": {
   "ja": "そのマシンの資料がこれだ。",
   "text": "Voici le dossier sur cette machine.",
   "style": "caption"
  },
  "012e3000/06": {
   "ja": "遺伝子工学と薬物を駆使した…",
   "text": "Grâce au génie génétique et aux drogues…",
   "style": "caption"
  },
  "012e3000/07": {
   "ja": "…まさにバケモノと言っていい！",
   "text": "…on peut vraiment parler de monstre !",
   "style": "caption"
  },
  "012e3000/08": {
   "ja": "そして…やつらの狙いは君なのだ！",
   "text": "Et… c'est toi qu'ils visent !",
   "style": "caption"
  },
  "012e3000/09": {
   "ja": "ただ、これは情報局の総意ではない…",
   "text": "Mais ce n'est pas la volonté de tout le service…",
   "style": "caption"
  },
  "012e3000/10": {
   "ja": "一部の人間の暴走なのだ…",
   "text": "Ce ne sont que quelques éléments incontrôlés…",
   "style": "caption"
  },
  "012e3000/11": {
   "ja": "情報を流す意図を汲んでくれ…デューク！",
   "text": "Comprends pourquoi je te transmets ces informations… Duke !",
   "style": "caption"
  },
  "012e3000/12": {
   "ja": "見つけたぞ…ゴルゴ13！",
   "text": "Je t'ai trouvé… Golgo 13 !",
   "style": "caption"
  },
  "012e3000/13": {
   "ja": "情報局部長　ウイリアムズ",
   "text": "Dir. du service Williams",
   "style": "plate"
  },
  "0269d000/00": {
   "ja": "お、おしまいだ…",
   "text": "C'est… la fin…",
   "style": "caption"
  },
  "0269d000/01": {
   "ja": "彼に敵対する者は、必ず…",
   "text": "Quiconque s'oppose à lui finit toujours…",
   "style": "caption"
  },

  "0029f000/00": {
   "ja": "諸君、よく来てくれた！",
   "text": "Messieurs, merci d'être venus !",
   "style": "caption"
  },
  "0029f000/01": {
   "ja": "当家自慢の庭園にでもどうかね…",
   "text": "Que diriez-vous d'aller dans le jardin dont notre maison est si fière…",
   "style": "caption"
  },
  "0029f000/02": {
   "ja": "用件を聞こう…",
   "text": "Voyons de quoi il s'agit…",
   "style": "caption"
  },
  "0029f000/03": {
   "ja": "実は、遺憾ながらMI6内部の あるグループが…",
   "text": "En fait, malheureusement, un groupe au sein du MI6…",
   "style": "caption"
  },
  "0029f000/04": {
   "ja": "カネにつられて、私の暗殺を 目論んでいるのだ！",
   "text": "attiré par l'argent, projette de m'assassiner !",
   "style": "caption"
  },
  "0029f000/05": {
   "ja": "そこで今週末、私の家に グループのトップを呼び出す…",
   "text": "Ce week-end, j'invite donc le chef de ce groupe chez moi…",
   "style": "caption"
  },
  "0029f000/06": {
   "ja": "その席で、君に問題グループのトップを 除去して欲しい！",
   "text": "Je veux que vous éliminiez ce chef de groupe sur place !",
   "style": "caption"
  },
  "0029f000/07": {
   "ja": "さて、どこのグループが 私を暗殺するのかね？",
   "text": "Voyons, quel groupe projette de m'assassiner ?",
   "style": "caption"
  },
  "0029f000/08": {
   "ja": "そ、そんな…！！",
   "text": "N-non, pas possible… !!",
   "style": "caption"
  },
  "0029f000/09": {
   "ja": "ここに証拠資料もある… カネ目当てとは愚かしい…",
   "text": "J'ai ici les preuves… Agir pour l'argent est stupide…",
   "style": "caption"
  },
  "0029f000/10": {
   "ja": "しかし、私は逃げ隠れする つもりはない。",
   "text": "Mais je n'ai pas l'intention de fuir ni de me cacher.",
   "style": "caption"
  },
  "0029f000/11": {
   "ja": "むしろ、そのチャンスを 与えようではないか！",
   "text": "Au contraire, donnons-leur cette occasion !",
   "style": "caption"
  },
  "0029f000/12": {
   "ja": "ただ、私は自慢のこの庭で 生涯を閉じたい…",
   "text": "Mais je voudrais finir mes jours dans ce jardin dont je suis fier…",
   "style": "caption"
  },
  "0029f000/13": {
   "ja": "さあ、それぞれ別の場所で 資料を読んで…",
   "text": "Allons, lisez chacun les documents dans un endroit différent…",
   "style": "caption"
  },
  "0029f000/14": {
   "ja": "逃走経路を考えた上で、 私を狙うがいい…！！",
   "text": "Une fois votre voie de fuite prévue, vous pouvez me viser…!!",
   "style": "caption"
  },
  "0029f000/15": {
   "ja": "MI6部長　ヒューム",
   "text": "Chef MI6 Hume",
   "style": "plate"
  },
  "0029f000/16": {
   "ja": "MI6 幹部",
   "text": "Cadre du MI6",
   "style": "plate"
  },
  "004ca000/00": {
   "ja": "国連専用機…聞こえるか？",
   "text": "Avion spécial de l'ONU… m'entendez-vous ?",
   "style": "caption"
  },
  "004ca000/01": {
   "ja": "この機はハイジャックされた！",
   "text": "Cet appareil est détourné !",
   "style": "caption"
  },
  "004ca000/02": {
   "ja": "機長がコックピットに 来て欲しいと…",
   "text": "Le commandant demande que vous veniez dans le cockpit…",
   "style": "caption"
  },
  "004ca000/03": {
   "ja": "…緊急事態のようです！",
   "text": "…Il semble que ce soit une urgence !",
   "style": "caption"
  },
  "004ca000/04": {
   "ja": "地上からハイジャックとは どういう事だ！？",
   "text": "Un détournement depuis le sol ? Qu'est-ce que ça veut dire !?",
   "style": "caption"
  },
  "004ca000/05": {
   "ja": "我々にはスティンガーがある… 軍を即座に撤退させろ！",
   "text": "Nous avons des Stinger… Retirez immédiatement l'armée !",
   "style": "caption"
  },
  "004ca000/06": {
   "ja": "ス、スティンガーミサイル…！",
   "text": "D-des missiles Stinger… !",
   "style": "caption"
  },
  "004ca000/07": {
   "ja": "用件を聞こうか…",
   "text": "Voyons de quoi il s'agit…",
   "style": "caption"
  },
  "004ca000/08": {
   "ja": "き、緊急事態なんです…",
   "text": "C'est une u-urgence…",
   "style": "caption"
  },
  "004ca000/09": {
   "ja": "犯人の反政府ゲリラ・リーダー、 シアドです。",
   "text": "Le coupable est le chef de la guérilla antigouvernementale, Siad.",
   "style": "caption"
  },
  "004ca000/10": {
   "ja": "たった一発のスティンガーで ハイジャックしたのです…",
   "text": "Il a détourné l'avion avec un seul Stinger…",
   "style": "caption"
  },
  "004ca000/11": {
   "ja": "軍隊の展開は困難ですが、 スティンガーさえなければ…",
   "text": "Déployer l'armée est difficile, mais sans le Stinger…",
   "style": "caption"
  },
  "004ca000/12": {
   "ja": "お願いします…スティンガーを 排除してください！",
   "text": "Je vous en prie… éliminez le Stinger !",
   "style": "caption"
  },
  "004ca000/13": {
   "ja": "ちっ、畜生！ 思い知らせてやる…！",
   "text": "Merde, saloperie ! Je vais te faire payer…!",
   "style": "caption"
  },
  "004ca000/14": {
   "ja": "国連紛争地域視察団",
   "text": "Inspection ONU",
   "style": "plate"
  },
  "004ca000/15": {
   "ja": "国連事務局",
   "text": "Secrétariat de l'ONU",
   "style": "plate"
  },
  "006bf000/00": {
   "ja": "私がコンタクトをお願いした タルッフィです…",
   "text": "Je suis Taruffi, celui qui vous a demandé de prendre contact…",
   "style": "caption"
  },
  "006bf000/01": {
   "ja": "用件を聞こう…",
   "text": "Voyons de quoi il s'agit…",
   "style": "caption"
  },
  "006bf000/02": {
   "ja": "ターゲットは女優のセラフィーニです。",
   "text": "La cible est l'actrice Serafini.",
   "style": "caption"
  },
  "006bf000/03": {
   "ja": "しかし殺すのではありません…",
   "text": "Mais il ne s'agit pas de la tuer…",
   "style": "caption"
  },
  "006bf000/04": {
   "ja": "実は彼女の交際している男 というのが、",
   "text": "En fait, l'homme qu'elle fréquente…",
   "style": "caption"
  },
  "006bf000/05": {
   "ja": "若手シューズデザイナーの ヴィロレーシなんですが…",
   "text": "est un jeune créateur de chaussures, Viroresi…",
   "style": "caption"
  },
  "006bf000/06": {
   "ja": "彼の資金はマフィアから 出ているのです。",
   "text": "Ses fonds viennent de la mafia.",
   "style": "caption"
  },
  "006bf000/07": {
   "ja": "もし、彼の靴が原因でセラフィーニが 怪我をしたら…",
   "text": "Si Serafini se blessait à cause de ses chaussures…",
   "style": "caption"
  },
  "006bf000/08": {
   "ja": "マスコミもこの事を 放ってはおかないでしょう。",
   "text": "la presse ne laisserait pas passer ça.",
   "style": "caption"
  },
  "006bf000/09": {
   "ja": "つまり、彼女の靴を 狙撃して欲しいのです！",
   "text": "Autrement dit, je veux que vous tiriez sur sa chaussure !",
   "style": "caption"
  },
  "006bf000/10": {
   "ja": "お願いできないでしょうか… ゴルゴ13！！",
   "text": "Puis-je compter sur vous… Golgo 13 !!",
   "style": "caption"
  },
  "006bf000/11": {
   "ja": "靴製造者協会会長　タルッフィ",
   "text": "Pdt chaussures Taruffi",
   "style": "plate"
  },
  "006bf000/12": {
   "ja": "女優　セラフィーニ",
   "text": "Actrice Serafini",
   "style": "plate"
  },
  "006bf000/13": {
   "ja": "シューズデザイナー　ヴィロレーシ",
   "text": "Styliste Viroresi",
   "style": "plate"
  },
  "00823000/00": {
   "ja": "…Mr.トウゴウか！？ いつの間に…",
   "text": "…M. Togo ?! Depuis quand êtes-vous là…",
   "style": "caption"
  },
  "00823000/01": {
   "ja": "…そっちが入ってくる 15分前からいる。",
   "text": "…Je suis là depuis quinze minutes avant votre arrivée.",
   "style": "caption"
  },
  "00823000/02": {
   "ja": "依頼人といえど事前の観察を 欠かさないルールでしたな…",
   "text": "Même pour un client, la règle est de ne jamais omettre l'observation préalable, n'est-ce pas…",
   "style": "caption"
  },
  "00823000/03": {
   "ja": "さっそくだが…フォー・コンツェルンの ダイヤを狙撃して欲しい！",
   "text": "Sans attendre… je veux que vous tiriez sur le diamant du Four Konzern !",
   "style": "caption"
  },
  "00823000/04": {
   "ja": "公にはなっていないが、ゆうに 1000カラットはある…",
   "text": "Ce n'est pas public, mais il fait largement 1000 carats…",
   "style": "caption"
  },
  "00823000/05": {
   "ja": "もちろんダイヤは 地上最強の硬度を有する…",
   "text": "Bien sûr, le diamant possède la dureté la plus élevée sur terre…",
   "style": "caption"
  },
  "00823000/06": {
   "ja": "だからこそ、あなたに 依頼するのだ…Mr.トウゴウ！",
   "text": "C'est justement pourquoi nous nous adressons à vous… M. Togo !",
   "style": "caption"
  },
  "00823000/07": {
   "ja": "これをもらおう…",
   "text": "Je prends ceci…",
   "style": "caption"
  },
  "00823000/08": {
   "ja": "ただし、要求通りに職人に カットしてもらいたい…",
   "text": "Mais je veux qu'un artisan le taille comme exigé…",
   "style": "caption"
  },
  "00823000/09": {
   "ja": "このダイヤを一撃で 打ち砕いて欲しい…",
   "text": "Je veux que vous brisiez ce diamant d'un seul coup…",
   "style": "caption"
  },
  "00823000/10": {
   "ja": "…気に入ったぞ、若いの！",
   "text": "…Il me plaît, jeune homme !",
   "style": "caption"
  },
  "00823000/11": {
   "ja": "ダイヤを砕くには、 結晶方向へ逆らって…",
   "text": "Pour briser un diamant, il faut aller à l'encontre du sens du cristal…",
   "style": "caption"
  },
  "00823000/12": {
   "ja": "正反対のポイントに打撃を 加えることだ！",
   "text": "en frappant au point diamétralement opposé !",
   "style": "caption"
  },
  "00823000/13": {
   "ja": "J&Iカンパニー代表　コリンズ",
   "text": "J&I Company Collins",
   "style": "plate"
  },
  "00823000/14": {
   "ja": "フォー・コンツェルン総帥　エイモン",
   "text": "Four Konzern Amon",
   "style": "plate"
  },
  "00941000/00": {
   "ja": "ちょっと速すぎる気がするが…",
   "text": "Ça me semble un peu trop rapide…",
   "style": "caption"
  },
  "00941000/01": {
   "ja": "…ここを動くな。",
   "text": "…Ne bouge pas d'ici.",
   "style": "caption"
  },
  "00941000/02": {
   "ja": "見に行くのか？",
   "text": "Tu vas voir ?",
   "style": "caption"
  },
  "00941000/04": {
   "ja": "ううっ…",
   "text": "Ngh…",
   "style": "caption"
  },
  "00941000/05": {
   "ja": "くそっ！！",
   "text": "Merde !!",
   "style": "caption"
  },
  "00941000/06": {
   "ja": "へへ…もうブレーキは使えないぜ…",
   "text": "Hé hé… on ne peut plus freiner…",
   "style": "caption"
  },
  "00941000/07": {
   "ja": "この先の崖で…",
   "text": "À la falaise, juste devant…",
   "style": "caption"
  },
  "00941000/08": {
   "ja": "殺し屋　シュミット",
   "text": "Tueur Schmitt",
   "style": "plate"
  },
  "00941000/09": {
   "ja": "じゃあ、このままでは崖に 転落するというのか…！！",
   "text": "Alors, tel quel, on va tomber de la falaise… !!",
   "style": "caption"
  },

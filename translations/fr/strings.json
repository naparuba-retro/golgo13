    "03189b20/01": {
      "text": "La cible est Huang Dazong.",
      "style": "caption"
    },
    "03189b20/02": {
      "text": "Officiellement, il dirige un fabricant d'ordinateurs, mais…",
      "style": "caption"
    },
    "03189b20/03": {
      "text": "En coulisses, il fait de la contrebande de semi-conducteurs.",
      "style": "caption"
    },
    "03189b20/04": {
      "text": "Huang se trouve actuellement au Japon, mais",
      "style": "caption"
    },
    "03189b20/05": {
      "text": "Le problème, c'est la position de tir.",
      "style": "caption"
    },
    "03189b20/06": {
      "text": "Il habite au dernier étage d'une tour résidentielle.",
      "style": "caption"
    },
    "03189b20/07": {
      "text": "Pardon du dérangement, mais nous allons tourner un film.",
      "style": "caption"
    },
    "03189b20/08": {
      "text": "Nous utiliserons une cartouche à blanc.",
      "style": "caption"
    },
    "03189b20/09": {
      "text": "Aujourd'hui, nous avons quelque chose à montrer au président…",
      "style": "caption"
    },
    "03189b20/10": {
      "text": "Ce sera la pièce maîtresse de la campagne publicitaire.",
      "style": "caption"
    },
